# =============================================================================
# Base Ontology for Texas Hold'em Poker (alternative full house definition)
#
# This version is an alternative definition of poker, with two pair combinations
# fully expanded, but where full house is defined in terms of cardinalities of
# individual ranks.
# =============================================================================
#
# This ontology models the structure of Texas Hold'em poker in OWL 2 DL.
# Its domain covers the deck of cards used in the game and the classification
# of poker hands. Other aspects, such as betting, rounds, and positions,
# are outside the scope of this ontology.
# =============================================================================

@prefix poker: <http://www.poker-ontology.org/poker#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

# -----------------------------------------------------------------------------
# OWL uses the Open World Assumption (OWA): information that has not been asserted
# is unknown, and is not necessarily false. Without additional restrictions,
# a reasoner could admit a fifth suit or a fourteenth rank that has yet to be defined.
#
# The Suit, Rank, and Card classes are closed using owl:oneOf to specify
# their possible individuals. The 52 card individuals are also declared
# AllDifferent so that the reasoner treats them as distinct entities.
# -----------------------------------------------------------------------------

<http://www.poker-ontology.org/poker>
    rdf:type owl:Ontology ;
    rdfs:label "Poker ontology"@en ;
    rdfs:comment "Ontology written in OWL 2 DL that models Texas Hold'em poker."@en ;
    owl:versionInfo "2.0.0" .


# =============================================================================
# Suits and Ranks
# =============================================================================

# Definition of the Suit class.
# Suit is closed using owl:oneOf to exclude additional suits.
poker:Suit a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:oneOf ( poker:Spades poker:Hearts poker:Diamonds poker:Clubs )
    ] ;
    rdfs:label "Suit"@en ;
    rdfs:comment "Suit of a card. Closed class: exactly Spades, Hearts, Diamonds, and Clubs."@en .

# Definition of the Rank class.
# Rank is closed using owl:oneOf to exclude additional ranks.
poker:Rank a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:oneOf ( poker:Two poker:Three poker:Four poker:Five poker:Six poker:Seven poker:Eight poker:Nine poker:Ten poker:Jack poker:Queen poker:King poker:Ace )
    ] ;
    rdfs:label "Rank"@en ;
    rdfs:comment "Rank of a card. Closed class: exactly Two, Three, Four, Five, Six, Seven, Eight, Nine, Ten, Jack, Queen, King, and Ace."@en .

# Definition of the Card class.
# Each card has exactly one suit and one rank, as ensured by the functional properties defined below.
poker:Card a owl:Class ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty poker:hasSuit ;
        owl:someValuesFrom poker:Suit
    ] ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty poker:hasRank ;
        owl:someValuesFrom poker:Rank
    ] ;
    rdfs:label "Card"@en ;
    rdfs:comment "A card from a standard 52-card deck."@en .


# Card subclasses by suit. These are used below to classify flushes and
# straight flushes by requiring all cards to have the same suit.
poker:CardOfHearts a owl:Class ;
    rdfs:subClassOf poker:Card ;
    owl:equivalentClass [
        a owl:Restriction ;
        owl:onProperty poker:hasSuit ;
        owl:hasValue poker:Hearts
    ] ;
    rdfs:label "Card of Hearts"@en ;
    rdfs:comment "A card of hearts from a standard 52-card deck."@en .

poker:CardOfDiamonds a owl:Class ;
    rdfs:subClassOf poker:Card ;
    owl:equivalentClass [
        a owl:Restriction ;
        owl:onProperty poker:hasSuit ;
        owl:hasValue poker:Diamonds
    ] ;
    rdfs:label "Card of Diamonds"@en ;
    rdfs:comment "A card of diamonds from a standard 52-card deck."@en .

poker:CardOfSpades a owl:Class ;
    rdfs:subClassOf poker:Card ;
    owl:equivalentClass [
        a owl:Restriction ;
        owl:onProperty poker:hasSuit ;
        owl:hasValue poker:Spades
    ] ;
    rdfs:label "Card of Spades"@en ;
    rdfs:comment "A card of spades from a standard 52-card deck."@en .

poker:CardOfClubs a owl:Class ;
    rdfs:subClassOf poker:Card ;
    owl:equivalentClass [
        a owl:Restriction ;
        owl:onProperty poker:hasSuit ;
        owl:hasValue poker:Clubs
    ] ;
    rdfs:label "Card of Clubs"@en ;
    rdfs:comment "A card of clubs from a standard 52-card deck."@en .


# Card subclasses by rank. These are used below to classify pairs,
# three of a kind, and four of a kind by requiring a given number of cards of the same rank.
poker:CardOfTwo a owl:Class ;
    rdfs:subClassOf poker:Card ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty poker:hasRank ; owl:hasValue poker:Two ] ;
    rdfs:label "Card of Two"@en .

poker:CardOfThree a owl:Class ;
    rdfs:subClassOf poker:Card ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty poker:hasRank ; owl:hasValue poker:Three ] ;
    rdfs:label "Card of Three"@en .

poker:CardOfFour a owl:Class ;
    rdfs:subClassOf poker:Card ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty poker:hasRank ; owl:hasValue poker:Four ] ;
    rdfs:label "Card of Four"@en .

poker:CardOfFive a owl:Class ;
    rdfs:subClassOf poker:Card ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty poker:hasRank ; owl:hasValue poker:Five ] ;
    rdfs:label "Card of Five"@en .

poker:CardOfSix a owl:Class ;
    rdfs:subClassOf poker:Card ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty poker:hasRank ; owl:hasValue poker:Six ] ;
    rdfs:label "Card of Six"@en .

poker:CardOfSeven a owl:Class ;
    rdfs:subClassOf poker:Card ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty poker:hasRank ; owl:hasValue poker:Seven ] ;
    rdfs:label "Card of Seven"@en .

poker:CardOfEight a owl:Class ;
    rdfs:subClassOf poker:Card ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty poker:hasRank ; owl:hasValue poker:Eight ] ;
    rdfs:label "Card of Eight"@en .

poker:CardOfNine a owl:Class ;
    rdfs:subClassOf poker:Card ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty poker:hasRank ; owl:hasValue poker:Nine ] ;
    rdfs:label "Card of Nine"@en .

poker:CardOfTen a owl:Class ;
    rdfs:subClassOf poker:Card ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty poker:hasRank ; owl:hasValue poker:Ten ] ;
    rdfs:label "Card of Ten"@en .

poker:CardOfJack a owl:Class ;
    rdfs:subClassOf poker:Card ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty poker:hasRank ; owl:hasValue poker:Jack ] ;
    rdfs:label "Card of Jack"@en .

poker:CardOfQueen a owl:Class ;
    rdfs:subClassOf poker:Card ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty poker:hasRank ; owl:hasValue poker:Queen ] ;
    rdfs:label "Card of Queen"@en .

poker:CardOfKing a owl:Class ;
    rdfs:subClassOf poker:Card ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty poker:hasRank ; owl:hasValue poker:King ] ;
    rdfs:label "Card of King"@en .

poker:CardOfAce a owl:Class ;
    rdfs:subClassOf poker:Card ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty poker:hasRank ; owl:hasValue poker:Ace ] ;
    rdfs:label "Card of Ace"@en .

# Explicit disjointness of the Card subclasses.
# These classes are already mutually disjoint because hasRank is functional
# and the rank individuals are AllDifferent. Explicit disjointness avoids
# repeating this inference in branches of classifiers that use owl:unionOf
# (such as pair, three of a kind, four of a kind, and straight),
# which becomes relevant as the ontology grows in complexity.

[] a owl:AllDisjointClasses ;
    owl:members ( poker:CardOfSpades poker:CardOfHearts poker:CardOfDiamonds poker:CardOfClubs ) .

[] a owl:AllDisjointClasses ;
    owl:members (
        poker:CardOfTwo poker:CardOfThree poker:CardOfFour poker:CardOfFive
        poker:CardOfSix poker:CardOfSeven poker:CardOfEight poker:CardOfNine
        poker:CardOfTen poker:CardOfJack poker:CardOfQueen poker:CardOfKing poker:CardOfAce
    ) .


# =============================================================================
# Hand Types
# =============================================================================
#
# Hand ranking in Texas Hold'em poker, from lowest to highest:
#
#   Hand: The best five-card combination selected from a player's cards and the community cards.
#   High card: No combination; the highest card determines the winner.
#   Pair: Two cards of the same rank.
#   Two pair: Two pairs of different ranks.
#   Three of a kind: Three cards of the same rank.
#   Straight: Five cards of consecutive ranks, possibly of different suits.
#   Flush: Five cards of the same suit, with different ranks.
#   Full house: Three of a kind and a pair of different ranks.
#   Four of a kind: Four cards of the same rank.
#   Straight flush: Five consecutive cards of the same suit.
#     Royal flush: A straight flush consisting of 10-J-Q-K-A of the same suit.
#
# Design decision: the hand types are not declared disjoint in this version.
# In the game, the categories are mutually exclusive when identifying the best
# hand. The ontology is intended to evaluate the effectiveness of OWL reasoners
# on sufficiently complex ontologies within a reasonable time. A more complex
# version with disjoint hand classes is left for future work.
# =============================================================================

# Definition of the Hand class.
poker:Hand a owl:Class ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty poker:containsCard ;
        owl:maxQualifiedCardinality "5"^^xsd:nonNegativeInteger ;
        owl:onClass poker:Card
    ] ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty poker:containsCard ;
        owl:minQualifiedCardinality "5"^^xsd:nonNegativeInteger ;
        owl:onClass poker:Card
    ] ;
    rdfs:label "Hand"@en ;
    rdfs:comment "The best five-card combination selected from the player's cards and the community cards in Texas Hold'em poker."@en .

# Definition of the HighCard class.
# A hand without a specific combination, where the highest card wins.
# The definition is deliberately simple: since hand classes are not disjoint,
# any hand type could technically be classified as HighCard, which suffices here.
poker:HighCard a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            poker:Hand
            [
                a owl:Restriction ;
                owl:onProperty poker:containsCard ;
                owl:someValuesFrom poker:Card
            ]
        )
    ] ;
    rdfs:subClassOf poker:Hand ;
    rdfs:label "High card"@en ;
    rdfs:comment "A hand without a combination; the highest card determines the winner."@en .

# Definition of the Pair class.
# A hand containing two cards of the same rank. owl:unionOf is used over the 13
# rank subclasses because OWL 2 DL cannot express a shared rank generically.
poker:Pair a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            poker:Hand
            [
                a owl:Class ;
                owl:unionOf (
                    [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfTwo ]
                    [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfThree ]
                    [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfFour ]
                    [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfFive ]
                    [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfSix ]
                    [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfSeven ]
                    [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfEight ]
                    [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfNine ]
                    [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfTen ]
                    [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfJack ]
                    [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfQueen ]
                    [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfKing ]
                    [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfAce ]
                )
            ]
        )
    ] ;
    rdfs:label "Pair"@en ;
    rdfs:comment "A hand with two cards of the same rank and three additional cards of ranks different from the pair and from each other."@en .

# Definition of the TwoPair class.
# A hand containing two pairs of different ranks. The 78 possible unordered
# combinations of two distinct ranks are enumerated explicitly.
poker:TwoPair a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            poker:Hand
            [
                a owl:Class ;
                owl:unionOf (
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfTwo ]
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfThree ]
                    )]
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfTwo ]
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfFour ]
                    )]
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfTwo ]
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfFive ]
                    )]
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfTwo ]
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfSix ]
                    )]
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfTwo ]
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfSeven ]
                    )]
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfTwo ]
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfEight ]
                    )]
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfTwo ]
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfNine ]
                    )]
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfTwo ]
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfTen ]
                    )]
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfTwo ]
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfJack ]
                    )]
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfTwo ]
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfQueen ]
                    )]
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfTwo ]
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfKing ]
                    )]
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfTwo ]
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfAce ]
                    )]
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfThree ]
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfFour ]
                    )]
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfThree ]
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfFive ]
                    )]
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfThree ]
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfSix ]
                    )]
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfThree ]
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfSeven ]
                    )]
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfThree ]
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfEight ]
                    )]
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfThree ]
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfNine ]
                    )]
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfThree ]
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfTen ]
                    )]
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfThree ]
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfJack ]
                    )]
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfThree ]
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfQueen ]
                    )]
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfThree ]
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfKing ]
                    )]
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfThree ]
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfAce ]
                    )]
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfFour ]
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfFive ]
                    )]
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfFour ]
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfSix ]
                    )]
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfFour ]
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfSeven ]
                    )]
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfFour ]
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfEight ]
                    )]
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfFour ]
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfNine ]
                    )]
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfFour ]
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfTen ]
                    )]
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfFour ]
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfJack ]
                    )]
                    [ a owl:Class ; owl:intersectionOf (
