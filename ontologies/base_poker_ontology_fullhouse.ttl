poker:QueenOfClubs a poker:Card ; poker:hasSuit poker:Clubs ; poker:hasRank poker:Queen ; rdfs:label "Queen of Clubs"@en .
poker:KingOfClubs a poker:Card ; poker:hasSuit poker:Clubs ; poker:hasRank poker:King ; rdfs:label "King of Clubs"@en .
poker:AceOfClubs a poker:Card ; poker:hasSuit poker:Clubs ; poker:hasRank poker:Ace ; rdfs:label "Ace of Clubs"@en .


# Distinct individuals
# AllDifferent is required because OWL 2 DL does not assume distinct individuals
# for distinct names (the Unique Name Assumption does not apply). Without these
# declarations, a reasoner could identify TwoOfSpades and ThreeOfHearts as
# the same card unless their distinction is explicitly established.
# This applies to suits, ranks, and cards.

# 4 distinct suits.
[] a owl:AllDifferent ;
    owl:distinctMembers ( poker:Spades poker:Hearts poker:Diamonds poker:Clubs ) .

# 13 distinct ranks.
[] a owl:AllDifferent ;
    owl:distinctMembers ( poker:Two poker:Three poker:Four poker:Five poker:Six
                          poker:Seven poker:Eight poker:Nine poker:Ten poker:Jack
                          poker:Queen poker:King poker:Ace ) .

# 52 distinct cards.
[] a owl:AllDifferent ;
    owl:distinctMembers (
        poker:TwoOfSpades poker:ThreeOfSpades poker:FourOfSpades poker:FiveOfSpades
        poker:SixOfSpades poker:SevenOfSpades poker:EightOfSpades poker:NineOfSpades
        poker:TenOfSpades poker:JackOfSpades poker:QueenOfSpades poker:KingOfSpades poker:AceOfSpades
        poker:TwoOfHearts poker:ThreeOfHearts poker:FourOfHearts poker:FiveOfHearts
        poker:SixOfHearts poker:SevenOfHearts poker:EightOfHearts poker:NineOfHearts
        poker:TenOfHearts poker:JackOfHearts poker:QueenOfHearts poker:KingOfHearts poker:AceOfHearts
        poker:TwoOfDiamonds poker:ThreeOfDiamonds poker:FourOfDiamonds poker:FiveOfDiamonds
        poker:SixOfDiamonds poker:SevenOfDiamonds poker:EightOfDiamonds poker:NineOfDiamonds
        poker:TenOfDiamonds poker:JackOfDiamonds poker:QueenOfDiamonds poker:KingOfDiamonds poker:AceOfDiamonds
        poker:TwoOfClubs poker:ThreeOfClubs poker:FourOfClubs poker:FiveOfClubs
        poker:SixOfClubs poker:SevenOfClubs poker:EightOfClubs poker:NineOfClubs
        poker:TenOfClubs poker:JackOfClubs poker:QueenOfClubs poker:KingOfClubs poker:AceOfClubs
    ) .