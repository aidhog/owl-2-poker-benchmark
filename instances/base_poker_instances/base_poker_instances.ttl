# =============================================================================
# Instancias de manos de Póker Texas Hold'em
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix par: <http://www.poker-ontology.org/instancias/par#> .
@prefix doblepar: <http://www.poker-ontology.org/instancias/doblepar#> .
@prefix trio: <http://www.poker-ontology.org/instancias/trio#> .
@prefix escalera: <http://www.poker-ontology.org/instancias/escalera#> .
@prefix color: <http://www.poker-ontology.org/instancias/color#> .
@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix pokerh: <http://www.poker-ontology.org/instancias/poker#> .
@prefix escalera_color: <http://www.poker-ontology.org/instancias/escalera_color#> .
@prefix escalera_real: <http://www.poker-ontology.org/instancias/escalera_real#> .
@prefix poker: <http://www.poker-ontology.org/poker#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/todas>
    a owl:Ontology ;
    owl:imports <http://www.poker-ontology.org/poker> ;
    rdfs:label "Instancias de manos de Póker Texas Hold'em" ;
    rdfs:comment "ABox unificado con 40 manos de prueba, 4 por cada uno de los 10 tipos de manos de Póker Texas Hold'em." .


# =============================================================================
# 1. Carta Alta
# =============================================================================

carta_alta:Mano1 a poker:Hand ;
    rdfs:label "Carta Alta de As con Jota Nueve Seis Cuatro" ;
    poker:containsCard poker:AceDeHearts, poker:JackDeDiamonds, poker:NineDeSpades, poker:SixDeClubs, poker:FourDeDiamonds .

carta_alta:Mano2 a poker:Hand ;
    rdfs:label "Carta Alta de Rey con Diez Ocho Cinco Tres" ;
    poker:containsCard poker:KingDeClubs, poker:TenDeHearts, poker:EightDeDiamonds, poker:FiveDeClubs, poker:ThreeDeHearts .

carta_alta:Mano3 a poker:Hand ;
    rdfs:label "Carta Alta de Reina con Nueve Siete Cuatro Dos" ;
    poker:containsCard poker:QueenDeHearts, poker:NineDeDiamonds, poker:SevenDeClubs, poker:FourDeHearts, poker:TwoDeSpades .

carta_alta:Mano4 a poker:Hand ;
    rdfs:label "Carta Alta de Jota con Ocho Seis Cuatro Dos" ;
    poker:containsCard poker:JackDeClubs, poker:EightDeHearts, poker:SixDeSpades, poker:FourDeSpades, poker:TwoDeClubs .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( carta_alta:Mano1 carta_alta:Mano2 carta_alta:Mano3 carta_alta:Mano4 ) .

# =============================================================================
# 2. Par
# =============================================================================

par:Mano5 a poker:Hand ;
    rdfs:label "Par de Seises con As Reina Jota" ;
    poker:containsCard poker:SixDeHearts, poker:SixDeDiamonds, poker:AceDeSpades, poker:QueenDeSpades, poker:JackDeHearts .

par:Mano6 a poker:Hand ;
    rdfs:label "Par de Dieces con Rey Nueve Cinco" ;
    poker:containsCard poker:TenDeSpades, poker:TenDeClubs, poker:KingDeHearts, poker:NineDeClubs, poker:FiveDeSpades .

par:Mano7 a poker:Hand ;
    rdfs:label "Par de Ochos con As Jota Cuatro" ;
    poker:containsCard poker:EightDeSpades, poker:EightDeClubs, poker:AceDeDiamonds, poker:JackDeDiamonds, poker:FourDeDiamonds .

par:Mano8 a poker:Hand ;
    rdfs:label "Par de Treses con Reina Siete Dos" ;
    poker:containsCard poker:ThreeDeSpades, poker:ThreeDeDiamonds, poker:QueenDeDiamonds, poker:SevenDeSpades, poker:TwoDeHearts .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( par:Mano5 par:Mano6 par:Mano7 par:Mano8 ) .

# =============================================================================
# 3. Doble Par
# =============================================================================

doblepar:Mano9 a poker:Hand ;
    rdfs:label "Doble Par de Jotas y Cuatros con Rey" ;
    poker:containsCard poker:JackDeHearts, poker:JackDeSpades, poker:FourDeClubs, poker:FourDeDiamonds, poker:KingDeSpades ;
    poker:handHasPair poker:Jack, poker:Four .

doblepar:Mano10 a poker:Hand ;
    rdfs:label "Doble Par de Sietes y Doses con As" ;
    poker:containsCard poker:SevenDeHearts, poker:SevenDeDiamonds, poker:TwoDeHearts, poker:TwoDeDiamonds, poker:AceDeClubs ;
    poker:handHasPair poker:Seven, poker:Two .

doblepar:Mano11 a poker:Hand ;
    rdfs:label "Doble Par de Reyes y Nueves con Jota" ;
    poker:containsCard poker:KingDeDiamonds, poker:KingDeClubs, poker:NineDeHearts, poker:NineDeSpades, poker:JackDeDiamonds ;
    poker:handHasPair poker:King, poker:Nine .

doblepar:Mano12 a poker:Hand ;
    rdfs:label "Doble Par de Ases y Cincos con Ocho" ;
    poker:containsCard poker:AceDeHearts, poker:AceDeSpades, poker:FiveDeHearts, poker:FiveDeDiamonds, poker:EightDeHearts ;
    poker:handHasPair poker:Ace, poker:Five .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( doblepar:Mano9 doblepar:Mano10 doblepar:Mano11 doblepar:Mano12 ) .

# =============================================================================
# 4. Trío
# =============================================================================

trio:Mano13 a poker:Hand ;
    rdfs:label "Trío de Cuatros con As Jota" ;
    poker:containsCard poker:FourDeHearts, poker:FourDeSpades, poker:FourDeClubs, poker:AceDeHearts, poker:JackDeSpades .

trio:Mano14 a poker:Hand ;
    rdfs:label "Trío de Ochos con Rey Seis" ;
    poker:containsCard poker:EightDeHearts, poker:EightDeSpades, poker:EightDeDiamonds, poker:KingDeHearts, poker:SixDeClubs .

trio:Mano15 a poker:Hand ;
    rdfs:label "Trío de Jotas con As Tres" ;
    poker:containsCard poker:JackDeHearts, poker:JackDeSpades, poker:JackDeClubs, poker:AceDeClubs, poker:ThreeDeHearts .

trio:Mano16 a poker:Hand ;
    rdfs:label "Trío de Sietes con Reina Dos" ;
    poker:containsCard poker:SevenDeHearts, poker:SevenDeSpades, poker:SevenDeDiamonds, poker:QueenDeClubs, poker:TwoDeHearts .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( trio:Mano13 trio:Mano14 trio:Mano15 trio:Mano16 ) .

# =============================================================================
# 5. Escalera
# =============================================================================

escalera:Mano17 a poker:Hand ;
    rdfs:label "Escalera de A-2-3-4-5" ;
    poker:containsCard poker:AceDeSpades, poker:TwoDeHearts, poker:ThreeDeDiamonds, poker:FourDeClubs, poker:FiveDeSpades .

escalera:Mano18 a poker:Hand ;
    rdfs:label "Escalera de 3-4-5-6-7" ;
    poker:containsCard poker:ThreeDeHearts, poker:FourDeDiamonds, poker:FiveDeClubs, poker:SixDeSpades, poker:SevenDeHearts .

escalera:Mano19 a poker:Hand ;
    rdfs:label "Escalera de 6-7-8-9-10" ;
    poker:containsCard poker:SixDeDiamonds, poker:SevenDeClubs, poker:EightDeSpades, poker:NineDeDiamonds, poker:TenDeHearts .

escalera:Mano20 a poker:Hand ;
    rdfs:label "Escalera de 8-9-10-J-Q" ;
    poker:containsCard poker:EightDeDiamonds, poker:NineDeClubs, poker:TenDeDiamonds, poker:JackDeDiamonds, poker:QueenDeSpades .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera:Mano17 escalera:Mano18 escalera:Mano19 escalera:Mano20 ) .

# =============================================================================
# 6. Color
# =============================================================================

color:Mano21 a poker:Hand ;
    rdfs:label "Color de Rey Nueve Siete Cuatro Dos de Diamantes" ;
    poker:containsCard poker:KingDeDiamonds, poker:NineDeDiamonds, poker:SevenDeDiamonds, poker:FourDeDiamonds, poker:TwoDeDiamonds .

color:Mano22 a poker:Hand ;
    rdfs:label "Color de As Diez Ocho Cinco Tres de Tréboles" ;
    poker:containsCard poker:AceDeClubs, poker:TenDeClubs, poker:EightDeClubs, poker:FiveDeClubs, poker:ThreeDeClubs .

color:Mano23 a poker:Hand ;
    rdfs:label "Color de Reina Jota Siete Cuatro Dos de Picas" ;
    poker:containsCard poker:QueenDeSpades, poker:JackDeSpades, poker:SevenDeSpades, poker:FourDeSpades, poker:TwoDeSpades .

color:Mano24 a poker:Hand ;
    rdfs:label "Color de As Rey Nueve Seis Cuatro de Corazones" ;
    poker:containsCard poker:AceDeHearts, poker:KingDeHearts, poker:NineDeHearts, poker:SixDeHearts, poker:FourDeHearts .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( color:Mano21 color:Mano22 color:Mano23 color:Mano24 ) .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano25 a poker:Hand ;
    rdfs:label "Full de Trío de Cincos con Par de Reyes" ;
    poker:containsCard poker:FiveDeHearts, poker:FiveDeSpades, poker:FiveDeDiamonds, poker:KingDeHearts, poker:KingDeSpades ;
    poker:handHasPair poker:Five, poker:King .

full:Mano26 a poker:Hand ;
    rdfs:label "Full de Trío de Ochos con Par de Jotas" ;
    poker:containsCard poker:EightDeHearts, poker:EightDeSpades, poker:EightDeDiamonds, poker:JackDeHearts, poker:JackDeSpades ;
    poker:handHasPair poker:Eight, poker:Jack .

full:Mano27 a poker:Hand ;
    rdfs:label "Full de Trío de Doses con Par de Ases" ;
    poker:containsCard poker:TwoDeHearts, poker:TwoDeSpades, poker:TwoDeDiamonds, poker:AceDeHearts, poker:AceDeSpades ;
    poker:handHasPair poker:Two, poker:Ace .

full:Mano28 a poker:Hand ;
    rdfs:label "Full de Trío de Reinas con Par de Sietes" ;
    poker:containsCard poker:QueenDeHearts, poker:QueenDeSpades, poker:QueenDeDiamonds, poker:SevenDeHearts, poker:SevenDeSpades ;
    poker:handHasPair poker:Queen, poker:Seven .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano25 full:Mano26 full:Mano27 full:Mano28 ) .

# =============================================================================
# 8. Póker
# =============================================================================

pokerh:Mano29 a poker:Hand ;
    rdfs:label "Póker de Cincos con Rey de Tréboles" ;
    poker:containsCard poker:FiveDeHearts, poker:FiveDeSpades, poker:FiveDeDiamonds, poker:FiveDeClubs, poker:KingDeClubs .

pokerh:Mano30 a poker:Hand ;
    rdfs:label "Póker de Nueves con As de Corazones" ;
    poker:containsCard poker:NineDeHearts, poker:NineDeSpades, poker:NineDeDiamonds, poker:NineDeClubs, poker:AceDeHearts .

pokerh:Mano31 a poker:Hand ;
    rdfs:label "Póker de Reinas con Diez de Diamantes" ;
    poker:containsCard poker:QueenDeHearts, poker:QueenDeSpades, poker:QueenDeDiamonds, poker:QueenDeClubs, poker:TenDeDiamonds .

pokerh:Mano32 a poker:Hand ;
    rdfs:label "Póker de Treses con As de Picas" ;
    poker:containsCard poker:ThreeDeHearts, poker:ThreeDeSpades, poker:ThreeDeDiamonds, poker:ThreeDeClubs, poker:AceDeSpades .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( pokerh:Mano29 pokerh:Mano30 pokerh:Mano31 pokerh:Mano32 ) .

# =============================================================================
# 9. Escalera de Color
# =============================================================================

escalera_color:Mano33 a poker:Hand ;
    rdfs:label "Escalera de Color 3-4-5-6-7 de Diamantes" ;
    poker:containsCard poker:ThreeDeDiamonds, poker:FourDeDiamonds, poker:FiveDeDiamonds, poker:SixDeDiamonds, poker:SevenDeDiamonds .

escalera_color:Mano34 a poker:Hand ;
    rdfs:label "Escalera de Color 5-6-7-8-9 de Picas" ;
    poker:containsCard poker:FiveDeSpades, poker:SixDeSpades, poker:SevenDeSpades, poker:EightDeSpades, poker:NineDeSpades .

escalera_color:Mano35 a poker:Hand ;
    rdfs:label "Escalera de Color 6-7-8-9-10 de Tréboles" ;
    poker:containsCard poker:SixDeClubs, poker:SevenDeClubs, poker:EightDeClubs, poker:NineDeClubs, poker:TenDeClubs .

escalera_color:Mano36 a poker:Hand ;
    rdfs:label "Escalera de Color 8-9-10-J-Q de Corazones" ;
    poker:containsCard poker:EightDeHearts, poker:NineDeHearts, poker:TenDeHearts, poker:JackDeHearts, poker:QueenDeHearts .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_color:Mano33 escalera_color:Mano34 escalera_color:Mano35 escalera_color:Mano36 ) .

# =============================================================================
# 10. Escalera Real
# =============================================================================

escalera_real:Mano37 a poker:Hand ;
    rdfs:label "Escalera Real de Picas" ;
    poker:containsCard poker:TenDeSpades, poker:JackDeSpades, poker:QueenDeSpades, poker:KingDeSpades, poker:AceDeSpades .

escalera_real:Mano38 a poker:Hand ;
    rdfs:label "Escalera Real de Corazones" ;
    poker:containsCard poker:TenDeHearts, poker:JackDeHearts, poker:QueenDeHearts, poker:KingDeHearts, poker:AceDeHearts .

escalera_real:Mano39 a poker:Hand ;
    rdfs:label "Escalera Real de Diamantes" ;
    poker:containsCard poker:TenDeDiamonds, poker:JackDeDiamonds, poker:QueenDeDiamonds, poker:KingDeDiamonds, poker:AceDeDiamonds .

escalera_real:Mano40 a poker:Hand ;
    rdfs:label "Escalera Real de Tréboles" ;
    poker:containsCard poker:TenDeClubs, poker:JackDeClubs, poker:QueenDeClubs, poker:KingDeClubs, poker:AceDeClubs .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_real:Mano37 escalera_real:Mano38 escalera_real:Mano39 escalera_real:Mano40 ) .
