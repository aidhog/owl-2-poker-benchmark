# Definition of the ThreeOfAKind class.
# A hand containing three cards of the same rank. owl:unionOf is used over the 13
# rank subclasses because OWL 2 DL cannot express a shared rank generically.
poker:ThreeOfAKind a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            poker:Hand
            [
                a owl:Class ;
                owl:unionOf (
                    [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfTwo ]
                    [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfThree ]
                    [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfFour ]
                    [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfFive ]
                    [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfSix ]
                    [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfSeven ]
                    [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfEight ]
                    [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfNine ]
                    [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfTen ]
                    [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfJack ]
                    [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfQueen ]
                    [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfKing ]
                    [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfAce ]
                )
            ]
        )
    ] ;
    rdfs:label "Three of a kind"@en ;
    rdfs:comment "A hand with three cards of the same rank and two other cards of different ranks from the three of a kind and from each other."@en .

# Definition of the Straight class.
# A hand containing five cards of consecutive ranks, possibly of different suits.
# The ten possible sequences of consecutive ranks are enumerated here.
# OWL 2 DL requires enumerating these sequences to express consecutive ranks
# without naming the specific cards in the hand.
poker:Straight a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            poker:Hand
            [
                a owl:Class ;
                owl:unionOf (
                    # A-2-3-4-5 
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:someValuesFrom poker:CardOfAce ]
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:someValuesFrom poker:CardOfTwo ]
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:someValuesFrom poker:CardOfThree ]
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:someValuesFrom poker:CardOfFour ]
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:someValuesFrom poker:CardOfFive ]
                    )]
                    # 2-3-4-5-6
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:someValuesFrom poker:CardOfTwo ]
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:someValuesFrom poker:CardOfThree ]
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:someValuesFrom poker:CardOfFour ]
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:someValuesFrom poker:CardOfFive ]
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:someValuesFrom poker:CardOfSix ]
                    )]
                    # 3-4-5-6-7
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:someValuesFrom poker:CardOfThree ]
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:someValuesFrom poker:CardOfFour ]
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:someValuesFrom poker:CardOfFive ]
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:someValuesFrom poker:CardOfSix ]
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:someValuesFrom poker:CardOfSeven ]
                    )]
                    # 4-5-6-7-8
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:someValuesFrom poker:CardOfFour ]
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:someValuesFrom poker:CardOfFive ]
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:someValuesFrom poker:CardOfSix ]
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:someValuesFrom poker:CardOfSeven ]
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:someValuesFrom poker:CardOfEight ]
                    )]
                    # 5-6-7-8-9
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:someValuesFrom poker:CardOfFive ]
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:someValuesFrom poker:CardOfSix ]
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:someValuesFrom poker:CardOfSeven ]
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:someValuesFrom poker:CardOfEight ]
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:someValuesFrom poker:CardOfNine ]
                    )]
                    # 6-7-8-9-10
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:someValuesFrom poker:CardOfSix ]
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:someValuesFrom poker:CardOfSeven ]
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:someValuesFrom poker:CardOfEight ]
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:someValuesFrom poker:CardOfNine ]
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:someValuesFrom poker:CardOfTen ]
                    )]
                    # 7-8-9-10-J
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:someValuesFrom poker:CardOfSeven ]
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:someValuesFrom poker:CardOfEight ]
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:someValuesFrom poker:CardOfNine ]
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:someValuesFrom poker:CardOfTen ]
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:someValuesFrom poker:CardOfJack ]
                    )]
                    # 8-9-10-J-Q
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:someValuesFrom poker:CardOfEight ]
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:someValuesFrom poker:CardOfNine ]
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:someValuesFrom poker:CardOfTen ]
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:someValuesFrom poker:CardOfJack ]
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:someValuesFrom poker:CardOfQueen ]
                    )]
                    # 9-10-J-Q-K
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:someValuesFrom poker:CardOfNine ]
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:someValuesFrom poker:CardOfTen ]
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:someValuesFrom poker:CardOfJack ]
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:someValuesFrom poker:CardOfQueen ]
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:someValuesFrom poker:CardOfKing ]
                    )]
                    # 10-J-Q-K-A 
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:someValuesFrom poker:CardOfTen ]
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:someValuesFrom poker:CardOfJack ]
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:someValuesFrom poker:CardOfQueen ]
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:someValuesFrom poker:CardOfKing ]
                        [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:someValuesFrom poker:CardOfAce ]
                    )]
                )
            ]
        )
    ] ;
    rdfs:label "Straight"@en ;
    rdfs:comment "A hand with five cards of consecutive ranks, possibly of different suits."@en .

# Definition of the Flush class.
# A hand containing five cards of the same suit, with different ranks.
# owl:unionOf is used over the four suit subclasses because OWL 2 DL
# cannot express a shared suit generically.
poker:Flush a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            poker:Hand
            [
                a owl:Class ;
                owl:unionOf (
                    [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "5"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfHearts ]
                    [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "5"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfDiamonds ]
                    [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "5"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfSpades ]
                    [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "5"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfClubs ]
                )
            ]
        )
    ] ;
    rdfs:label "Flush"@en ;
    rdfs:comment "A hand with five cards of the same suit, whose ranks need not be consecutive."@en .

# Definition of the FullHouse class.
# A full house has exactly five cards, with each rank occurring either zero,
# two, or three times. The five-card hand constraint and the disjoint rank
# classes ensure that one rank occurs twice and another occurs three times.
poker:FullHouse a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            poker:Hand
            [ a owl:Class ;
              owl:unionOf (
                [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:qualifiedCardinality "0"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfTwo ]
                [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:qualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfTwo ]
                [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:qualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfTwo ]
              )
            ]
            [ a owl:Class ;
              owl:unionOf (
                [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:qualifiedCardinality "0"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfThree ]
                [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:qualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfThree ]
                [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:qualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfThree ]
              )
            ]
            [ a owl:Class ;
              owl:unionOf (
                [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:qualifiedCardinality "0"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfFour ]
                [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:qualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfFour ]
                [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:qualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfFour ]
              )
            ]
            [ a owl:Class ;
              owl:unionOf (
                [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:qualifiedCardinality "0"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfFive ]
                [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:qualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfFive ]
                [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:qualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfFive ]
              )
            ]
            [ a owl:Class ;
              owl:unionOf (
                [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:qualifiedCardinality "0"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfSix ]
                [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:qualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfSix ]
                [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:qualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfSix ]
              )
            ]
            [ a owl:Class ;
              owl:unionOf (
                [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:qualifiedCardinality "0"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfSeven ]
                [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:qualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfSeven ]
                [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:qualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfSeven ]
              )
            ]
            [ a owl:Class ;
              owl:unionOf (
                [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:qualifiedCardinality "0"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfEight ]
                [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:qualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfEight ]
                [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:qualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfEight ]
              )
            ]
            [ a owl:Class ;
              owl:unionOf (
                [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:qualifiedCardinality "0"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfNine ]
                [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:qualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfNine ]
                [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:qualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfNine ]
              )
            ]
            [ a owl:Class ;
              owl:unionOf (
                [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:qualifiedCardinality "0"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfTen ]
                [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:qualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfTen ]
                [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:qualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfTen ]
              )
            ]
            [ a owl:Class ;
              owl:unionOf (
                [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:qualifiedCardinality "0"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfJack ]
                [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:qualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfJack ]
                [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:qualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfJack ]
              )
            ]
            [ a owl:Class ;
              owl:unionOf (
                [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:qualifiedCardinality "0"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfQueen ]
                [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:qualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfQueen ]
                [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:qualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfQueen ]
              )
            ]
            [ a owl:Class ;
              owl:unionOf (
                [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:qualifiedCardinality "0"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfKing ]
                [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:qualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfKing ]
                [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:qualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfKing ]
              )
            ]
            [ a owl:Class ;
              owl:unionOf (
                [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:qualifiedCardinality "0"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfAce ]
                [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:qualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfAce ]
                [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:qualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfAce ]
              )
            ]
        )
    ] ;
    rdfs:label "Full house"@en ;
    rdfs:comment "A hand with three cards of one rank and two cards of another rank."@en .

# Definition of the FourOfAKind class.
# A hand containing four cards of the same rank. owl:unionOf is used over the 13
# rank subclasses because OWL 2 DL cannot express a shared rank generically.
poker:FourOfAKind a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            poker:Hand
            [
                a owl:Class ;
                owl:unionOf (
                    [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfTwo ]
                    [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfThree ]
                    [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfFour ]
                    [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfFive ]
                    [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfSix ]
                    [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfSeven ]
                    [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfEight ]
                    [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfNine ]
                    [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfTen ]
                    [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfJack ]
                    [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfQueen ]
                    [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfKing ]
                    [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass poker:CardOfAce ]
                )
            ]
        )
    ] ;
    rdfs:label "Four of a kind"@en ;
    rdfs:comment "A hand with four cards of the same rank and one additional card."@en .

# Definition of the StraightFlush class.
# A hand containing five consecutive cards of the same suit. It is defined
# as the intersection of Straight and Flush, ensuring both properties in one hand.
poker:StraightFlush a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            poker:Straight
            poker:Flush
        )
    ] ;
    rdfs:label "Straight flush"@en ;
    rdfs:comment "A hand with five consecutive cards of the same suit."@en .

# Definition of the RoyalFlush class.
# A hand containing five consecutive cards of the same suit, 10-J-Q-K-A.
# It is a special case of a straight flush, defined as the intersection of
# StraightFlush and the presence of the five highest-ranked cards.
poker:RoyalFlush a owl:Class ;
    rdfs:subClassOf poker:StraightFlush ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            poker:StraightFlush
            [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:someValuesFrom poker:CardOfTen ]
            [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:someValuesFrom poker:CardOfJack ]
            [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:someValuesFrom poker:CardOfQueen ]
            [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:someValuesFrom poker:CardOfKing ]
            [ a owl:Restriction ; owl:onProperty poker:containsCard ; owl:someValuesFrom poker:CardOfAce ]
        )
    ] ;
    rdfs:label "Royal flush"@en ;
    rdfs:comment "A hand with the five highest consecutive ranks (10-J-Q-K-A)."@en .


# =============================================================================
# Object Properties
# =============================================================================

# hasSuit and hasRank are functional properties because a card has
# one suit and one rank. Together with owl:oneOf for Suit and Rank,
# this ensures that each card is uniquely characterized in the ontology.

# Definition of the hasSuit property.
# Associates each card with exactly one suit.
poker:hasSuit a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain poker:Card ;
    rdfs:range poker:Suit ;
    rdfs:label "Has suit"@en ;
    rdfs:comment "Property associating a card with its suit."@en .

# Definition of the hasRank property.
# Associates each card with exactly one rank.
poker:hasRank a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain poker:Card ;
    rdfs:range poker:Rank ;
    rdfs:label "Has rank"@en ;
    rdfs:comment "Property associating a card with its rank."@en .

# Definition of the containsCard property.
# Indicates that a hand contains a given card.
poker:containsCard a owl:ObjectProperty ;
    rdfs:domain poker:Hand ;
    rdfs:range poker:Card ;
    rdfs:label "Contains card"@en ;
    rdfs:comment "Property relating a hand to each of its cards."@en .

# =============================================================================
# ABox - Individuals
# =============================================================================
#
# 69 individuals in total: 4 suits, 13 ranks, and 52 cards.
# =============================================================================

# Suits
poker:Spades a poker:Suit ; rdfs:label "Spades"@en .
poker:Hearts a poker:Suit ; rdfs:label "Hearts"@en .
poker:Diamonds a poker:Suit ; rdfs:label "Diamonds"@en .
poker:Clubs a poker:Suit ; rdfs:label "Clubs"@en .

# Ranks
poker:Two a poker:Rank ; rdfs:label "Two"@en .
poker:Three a poker:Rank ; rdfs:label "Three"@en .
poker:Four a poker:Rank ; rdfs:label "Four"@en .
poker:Five a poker:Rank ; rdfs:label "Five"@en .
