poker:Ten a poker:Rank ; rdfs:label "Ten"@en .
poker:Jack a poker:Rank ; rdfs:label "Jack"@en .
poker:Queen a poker:Rank ; rdfs:label "Queen"@en .
poker:King a poker:Rank ; rdfs:label "King"@en .
poker:Ace a poker:Rank ; rdfs:label "Ace"@en .

